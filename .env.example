# ==============================================================================
# Environment Configuration Template for Ollama Chatbot
# Copy this file to .env and configure as needed: cp .env.example .env
# ==============================================================================

# Web Server Settings
PROJECT_NAME="دستیار هوشمند محلی بورس کالا"
HOST=0.0.0.0
PORT=8000
DEBUG=False
ENVIRONMENT=production

# Docker Registry & Mirror Settings
DOCKER_MIRROR=dockerhub.ime.co.ir/
DOCKER_REGISTRY_MIRROR=http://dockerhub.ime.co.ir
DEBIAN_MIRROR=https://linux.repo.ime.co.ir/repository/debian
# PIP_INDEX_URL=https://linux.repo.ime.co.ir/repository/pypi/simple

# Database & Authentication
DATABASE_URL=sqlite:///./chatbot.db
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Ollama LLM Connection
OLLAMA_BASE_URL=http://0.0.0.0:11434
DEFAULT_MODEL=qwen:0.5b

# Default Admin Account Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Retention & Chat Memory Settings
RETENTION_DAYS=10
MAX_MEMORY_MESSAGES=12
UPLOAD_MAX_BYTES=15728640

